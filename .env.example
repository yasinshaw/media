# Image generation - OpenAI-compatible images/generations endpoint
# Works with any provider that exposes /v1/images/generations:
#   - OpenAI:        https://api.openai.com/v1            (gpt-image-1)
#   - 中转站 bltcy:  https://api.bltcy.ai/v1               (gpt-image-2-all)
#   - Gemini 中转:   <your relay base>                     (gemini-3.1-flash-image-preview)
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.bltcy.ai/v1
IMAGE_MODEL=gpt-image-2-all

# Volcano TTS - Voiceover synthesis (TTS 2.0)
# https://www.volcengine.com/docs/6561/1257544
# New console (recommended):
VOLC_TTS_API_KEY=
# Old console (alternative):
# VOLC_TTS_APP_ID=
# VOLC_TTS_ACCESS_KEY=

# Tavily - Web search for research
# https://tavily.com/
TAVILY_API_KEY=
