{
  "total_segments": 22,
  "speaker": "zh_male_liufei_uranus_bigtts",
  "total_duration_seconds": 81.24,
  "segments": [
    {
      "index": 1,
      "shot": 1,
      "sub_index": 1,
      "file": "voiceover-01.mp3",
      "size_bytes": 34221,
      "text": "用AI写小说，不是你输入一句'帮我写个故事'就完了。",
      "duration_seconds": 4.27,
      "start": 0,
      "end": 4.27
    },
    {
      "index": 2,
      "shot": 2,
      "sub_index": 1,
      "file": "voiceover-02.mp3",
      "size_bytes": 59757,
      "text": "很多人第一次用AI写小说，得到的结果就是：文笔干巴巴、人物像纸片、情节全是套路。",
      "duration_seconds": 7.46,
      "start": 4.27,
      "end": 11.74
    },
    {
      "index": 3,
      "shot": 2,
      "sub_index": 2,
      "file": "voiceover-03.mp3",
      "size_bytes": 34221,
      "text": "问题不在AI不行，是你缺一套系统方法。",
      "duration_seconds": 4.27,
      "start": 11.74,
      "end": 16.01
    },
    {
      "index": 4,
      "shot": 3,
      "sub_index": 1,
      "file": "voiceover-04.mp3",
      "size_bytes": 18093,
      "text": "第一步，构建世界观。",
      "duration_seconds": 2.26,
      "start": 16.01,
      "end": 18.26
    },
    {
      "index": 5,
      "shot": 3,
      "sub_index": 2,
      "file": "voiceover-05.mp3",
      "size_bytes": 37293,
      "text": "别急着写正文，先把时代背景、核心规则打磨好。",
      "duration_seconds": 4.66,
      "start": 18.26,
      "end": 22.92
    },
    {
      "index": 6,
      "shot": 3,
      "sub_index": 3,
      "file": "voiceover-06.mp3",
      "size_bytes": 40365,
      "text": "这些设定会贯穿整部小说，是AI理解你故事的基础。",
      "duration_seconds": 5.04,
      "start": 22.92,
      "end": 27.96
    },
    {
      "index": 7,
      "shot": 4,
      "sub_index": 1,
      "file": "voiceover-07.mp3",
      "size_bytes": 16173,
      "text": "第二步，设计角色。",
      "duration_seconds": 2.02,
      "start": 27.96,
      "end": 29.98
    },
    {
      "index": 8,
      "shot": 4,
      "sub_index": 2,
      "file": "voiceover-08.mp3",
      "size_bytes": 29229,
      "text": "给每个角色写档案：性格、背景、说话方式。",
      "duration_seconds": 3.65,
      "start": 29.98,
      "end": 33.62
    },
    {
      "index": 9,
      "shot": 4,
      "sub_index": 3,
      "file": "voiceover-09.mp3",
      "size_bytes": 34221,
      "text": "角色越立体，AI生成的对话和行动就越自然。",
      "duration_seconds": 4.27,
      "start": 33.62,
      "end": 37.9
    },
    {
      "index": 10,
      "shot": 5,
      "sub_index": 1,
      "file": "voiceover-10.mp3",
      "size_bytes": 14829,
      "text": "第三步，列大纲。",
      "duration_seconds": 1.85,
      "start": 37.9,
      "end": 39.74
    },
    {
      "index": 11,
      "shot": 5,
      "sub_index": 2,
      "file": "voiceover-11.mp3",
      "size_bytes": 54573,
      "text": "把故事拆成章节，每章写清楚：发生了什么、人物有什么变化、埋了什么伏笔。",
      "duration_seconds": 6.82,
      "start": 39.74,
      "end": 46.56
    },
    {
      "index": 12,
      "shot": 5,
      "sub_index": 3,
      "file": "voiceover-12.mp3",
      "size_bytes": 22701,
      "text": "大纲越细，AI越不会跑偏。",
      "duration_seconds": 2.83,
      "start": 46.56,
      "end": 49.39
    },
    {
      "index": 13,
      "shot": 6,
      "sub_index": 1,
      "file": "voiceover-13.mp3",
      "size_bytes": 18093,
      "text": "第四步，逐章生成。",
      "duration_seconds": 2.26,
      "start": 49.39,
      "end": 51.65
    },
    {
      "index": 14,
      "shot": 6,
      "sub_index": 2,
      "file": "voiceover-14.mp3",
      "size_bytes": 25773,
      "text": "每次只写一章，写完立刻审查。",
      "duration_seconds": 3.22,
      "start": 51.65,
      "end": 54.86
    },
    {
      "index": 15,
      "shot": 6,
      "sub_index": 3,
      "file": "voiceover-15.mp3",
      "size_bytes": 53421,
      "text": "重点检查：情节是否推进了、角色是否符合人设、和前文有没有矛盾。",
      "duration_seconds": 6.67,
      "start": 54.86,
      "end": 61.54
    },
    {
      "index": 16,
      "shot": 7,
      "sub_index": 1,
      "file": "voiceover-16.mp3",
      "size_bytes": 22701,
      "text": "最关键的技能是上下文管理。",
      "duration_seconds": 2.83,
      "start": 61.54,
      "end": 64.37
    },
    {
      "index": 17,
      "shot": 7,
      "sub_index": 2,
      "file": "voiceover-17.mp3",
      "size_bytes": 16365,
      "text": "AI的记忆有限，",
      "duration_seconds": 2.04,
      "start": 64.37,
      "end": 66.41
    },
    {
      "index": 18,
      "shot": 7,
      "sub_index": 3,
      "file": "voiceover-18.mp3",
      "size_bytes": 11757,
      "text": "每开新章节，",
      "duration_seconds": 1.46,
      "start": 66.41,
      "end": 67.87
    },
    {
      "index": 19,
      "shot": 7,
      "sub_index": 4,
      "file": "voiceover-19.mp3",
      "size_bytes": 25965,
      "text": "要把前情提要和角色状态重新喂给它，",
      "duration_seconds": 3.24,
      "start": 67.87,
      "end": 71.11
    },
    {
      "index": 20,
      "shot": 7,
      "sub_index": 5,
      "file": "voiceover-20.mp3",
      "size_bytes": 18093,
      "text": "否则人物会突然失忆。",
      "duration_seconds": 2.26,
      "start": 71.11,
      "end": 73.37
    },
    {
      "index": 21,
      "shot": 8,
      "sub_index": 1,
      "file": "voiceover-21.mp3",
      "size_bytes": 41709,
      "text": "AI不会替你成为作家，但能让你的创作效率大幅提升。",
      "duration_seconds": 5.21,
      "start": 73.37,
      "end": 78.58
    },
    {
      "index": 22,
      "shot": 8,
      "sub_index": 2,
      "file": "voiceover-22.mp3",
      "size_bytes": 21357,
      "text": "关注我，分享更多AI创作技巧。",
      "duration_seconds": 2.66,
      "start": 78.58,
      "end": 81.24
    }
  ]
}